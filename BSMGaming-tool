```html
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BSMGaming | Official Portal</title>
<style>
:root {
  --bg:#0b1020; --panel:#151d32; --panel2:#202b45;
  --text:#f5f7ff; --muted:#aab5d0; --blue:#5b8cff;
  --purple:#9c68ff; --border:#34415f; --gold:#ffd66b;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font-family:system-ui,-apple-system,"Noto Sans JP",sans-serif}
header{padding:24px 16px;text-align:center;
  background:linear-gradient(135deg,#162c61,#4a247e)}
header h1{margin:0;font-size:30px;letter-spacing:2px}
header p{margin:8px 0 0;color:#dce5ff}
nav{display:flex;gap:8px;padding:12px;overflow-x:auto;
  background:#10172a;position:sticky;top:0;z-index:5}
button,.navbtn{border:0;border-radius:10px;padding:11px 14px;
  background:var(--panel2);color:white;font-weight:700;cursor:pointer}
nav button{white-space:nowrap}
button:hover{filter:brightness(1.15)}
nav button.active,.primary{background:var(--blue);color:white}
main{max-width:1050px;margin:auto;padding:18px}
.page{display:none}.page.active{display:block}
.card{background:var(--panel);border:1px solid var(--border);
  border-radius:16px;padding:18px;margin-bottom:16px}
h2{margin-top:0;font-size:22px}
h3{margin-bottom:8px}
.muted,small{color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
input,textarea,select{width:100%;padding:12px;margin:6px 0 12px;
  border:1px solid var(--border);border-radius:9px;
  background:#0c1428;color:white;font:inherit}
textarea{min-height:90px;resize:vertical}
label{display:block;color:var(--muted);font-size:14px}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.row input{flex:1;min-width:180px}
.badge{display:inline-block;padding:5px 9px;border-radius:7px;
  background:#283654;margin:3px;font-size:13px}
.tier{font-weight:900;min-width:42px;display:inline-block;
  padding:9px;border-radius:8px;text-align:center;margin-right:8px}
.tS{background:#e6bd48;color:#201800}.tA{background:#d56bff}
.tB{background:#5e94ff}.tC{background:#4b617e}
.notice{padding:12px;border-radius:10px;background:#101a31;
  border-left:4px solid var(--blue);margin:8px 0}
.danger{border-left-color:#ff6666}
.success{color:#7df0b1}.hidden{display:none!important}
footer{text-align:center;padding:25px;color:var(--muted)}
hr{border:0;border-top:1px solid var(--border);margin:18px 0}
#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);
  background:#283654;padding:12px 18px;border-radius:12px;
  display:none;z-index:20;max-width:90%;text-align:center}
#maintenance{position:fixed;inset:0;background:#080c18;z-index:99;
  display:none;align-items:center;justify-content:center;text-align:center;padding:24px}
@media(max-width:600px){header h1{font-size:24px}main{padding:12px}.card{padding:14px}}
</style>
</head>
<body>

<div id="maintenance">
  <div>
    <h1>🛠️ メンテナンス中</h1>
    <p>BSMGamingポータルは現在メンテナンス中です。</p>
    <p class="muted">管理者がメンテナンスを終了すると再び利用できます。</p>
  </div>
</div>

<header>
  <h1>⚡ BSMGaming</h1>
  <p>OFFICIAL GAMING PORTAL</p>
  <div class="row" style="justify-content:center;margin-top:14px">
    <span class="badge">🎮 Brawl Stars</span>
    <span class="badge">🏆 Aim for Victory</span>
  </div>
</header>

<nav id="navigation">
  <button class="active" data-page="home">🏠 ホーム</button>
  <button data-page="profile">🔎 プレイヤー検索</button>
  <button data-page="rank">🏆 ランク目安</button>
  <button data-page="ai">🤖 編成提案</button>
  <button data-page="tier">📊 Tier表</button>
  <button data-page="news">📰 お知らせ</button>
  <button data-page="members">👥 メンバー</button>
  <button data-page="gacha">🎲 ガチャ</button>
  <button data-page="account">👤 アカウント</button>
